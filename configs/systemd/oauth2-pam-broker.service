[Unit]
Description=oauth2-pam Authentication Broker
Documentation=https://github.com/scttfrdmn/oauth2-pam
After=network.target
Wants=network.target

[Service]
Type=simple
# No --log-level: the level comes from server.log_level in broker.yaml, which is
# where an operator looks for it. Adding the flag here would override that file
# and there would be nothing in it saying so — which is what happened before
# v0.4.0, when server.log_level was read by nothing and the flag's default was the
# only level this unit could ever log at.
ExecStart=/usr/local/bin/oauth2-pam-broker --config /etc/oauth2-pam/broker.yaml
Restart=always
RestartSec=5s

# Run as root so it can write to /var/run/oauth2-pam/ and /var/log/oauth2-pam/
User=root
Group=root

# Runtime directory. 0750 matches the MkdirAll the broker performs itself and the
# 0660 socket inside it. With Group=root above, the group is root, so this is the
# whole access model: only root can traverse the directory and connect to the
# socket. The PAM module qualifies because it runs inside sshd's pre-auth child.
#
# Do not relax either mode, and do not introduce an oauth2-pam group here, without
# reading the note above os.Chmod in internal/ipc/server.go first: an
# unauthenticated caller that reaches the socket can start device flows for any
# account, and several accepted risks in this project are accepted only because
# that caller can only be root.
RuntimeDirectory=oauth2-pam
RuntimeDirectoryMode=0750

# Log directory
LogsDirectory=oauth2-pam
LogsDirectoryMode=0750

# Keep the client secret out of broker.yaml. systemd reads the file as root
# before the hardening below applies, then stages it mode 0400 in a tmpfs at
# $CREDENTIALS_DIRECTORY under the name on the left, visible to this unit only.
# The config then refers to it by that bare name:
#
#   providers:
#     - name: github
#       client_secret_file: github-client-secret
#
# Uncomment once /etc/oauth2-pam/github.secret exists (chmod 600, owned by
# root). Without it, put the secret inline in broker.yaml — which then has to
# be 0600 root-owned itself, or the broker refuses to start.
# LoadCredential=github-client-secret:/etc/oauth2-pam/github.secret

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

# /etc/oauth2-pam is deliberately absent: the broker only reads from it. It used
# to be listed, which gave a root process that parses network-sourced identity
# data write access to its own config and to the enrollment file that decides
# which provider login becomes which Unix user. ProtectSystem=strict leaves /etc
# read-only, so oauth2-pam-enroll — a separate CLI, run by an administrator, not
# under this unit — is the only thing that can change either.
ReadWritePaths=/var/run/oauth2-pam /var/log/oauth2-pam
PrivateTmp=true

[Install]
WantedBy=multi-user.target
