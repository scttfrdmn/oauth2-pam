# The server side of the harness: the real broker daemon, plus the fake GitHub
# it talks to. Both are built from this image; docker-compose.yml runs them as
# two services so the broker reaches GitHub over the network, as it would in
# production.
#
# Build context is the repository root.

FROM golang:1.25-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -trimpath -o /out/oauth2-pam-broker ./cmd/broker \
 && go build -trimpath -o /out/oauth2-pam-admin  ./cmd/oauth2-pam-admin \
 && go build -trimpath -o /out/fakegithub        ./test/integration/fakegithub

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl openssl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/oauth2-pam-broker /out/oauth2-pam-admin /out/fakegithub /usr/local/bin/

# The broker refuses a plain-http github.base_url, so the stub serves TLS and
# its certificate goes into the system trust store — the same arrangement a
# GitHub Enterprise Server with an internal CA would need.
RUN mkdir -p /etc/fakegithub \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -subj "/CN=fakegithub" -addext "subjectAltName=DNS:fakegithub" \
      -keyout /etc/fakegithub/key.pem -out /etc/fakegithub/cert.pem \
 && cp /etc/fakegithub/cert.pem /usr/local/share/ca-certificates/fakegithub.crt \
 && update-ca-certificates

COPY test/integration/broker.yaml /etc/oauth2-pam/broker.yaml

# As of #58 the config's own mode is checked unconditionally, not only when a
# secret is inline, so a COPY that lands 0644 stops the broker from starting. The
# chmod is what a real deployment has to do too — the harness should need the same
# thing an operator needs, or it stops being evidence about deployment.
RUN chmod 0600 /etc/oauth2-pam/broker.yaml \
 && chown root:root /etc/oauth2-pam/broker.yaml

# The client secret lives in its own 0600 file, which is what broker.yaml points
# at. Written here rather than COPYed so the mode is not whatever the repo
# checkout happens to be: the broker refuses to read a secret out of a file other
# users can read.
RUN printf 'fakeclientsecret0000000000000000\n' > /etc/oauth2-pam/fakegithub.secret \
 && chmod 0600 /etc/oauth2-pam/fakegithub.secret \
 && chown root:root /etc/oauth2-pam/fakegithub.secret

RUN mkdir -p /var/log/oauth2-pam

# The same accounts the client container has, because the mapper's UID floor asks
# *this* host's passwd database what a mapped name resolves to. In production the
# broker and the login share a host by construction — the IPC transport is a Unix
# socket — but the harness splits them across two containers, so without this the
# floor would silently never apply and the cases covering it would pass for the
# wrong reason. The UIDs must match Dockerfile.client.
#
#   alice    1001  an ordinary account: allowed
#   bob      1002  an ordinary account: allowed
#   pgsvc     400  below min_uid: refused by the floor alone
#   postgres 1500  above min_uid, on the name denylist: refused by the name alone
RUN useradd --no-create-home --uid 1001 --shell /usr/sbin/nologin alice \
 && useradd --no-create-home --uid 1002 --shell /usr/sbin/nologin bob \
 && useradd --no-create-home --uid 400  --shell /usr/sbin/nologin pgsvc \
 && useradd --no-create-home --uid 1500 --shell /usr/sbin/nologin postgres

CMD ["oauth2-pam-broker", "--config", "/etc/oauth2-pam/broker.yaml"]
