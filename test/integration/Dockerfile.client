# The client side of the harness: a real sshd with a real oauth2_pam.so in its
# PAM stack. Logins are driven from run-tests.sh inside this container.
#
# Build context is the repository root.

# The module is plain C — no Go toolchain is involved in building it any more
# (issue #65), so the build stage is a Debian image with gcc, the two -dev packages
# and binutils. make is here because the compile line lives in the Makefile: the
# harness must build the module the way a release does, and a second copy of that
# command line here is a second place for the hardening flags to drift out of.
FROM debian:bookworm-slim AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc libc6-dev libpam0g-dev libjson-c-dev binutils make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Build the module the way make build-pam does — literally, by calling it — and
# then insist the entry points are actually in it. A .so without
# pam_sm_authenticate is exactly the defect this harness exists to catch, and it is
# silent at build time.
#
# The verification is scripts/verify-pam-symbols.sh rather than a loop written out
# here. This file held the fourth copy of that loop (issue #76): `make build-pam`,
# release.yml and the installer were consolidated onto the script and this one was
# missed, so the harness went on asking the question its own way — which is how the
# three earlier copies came to disagree about what counted as an answer. VERSION is
# passed explicitly because the build context has no .git for `git describe`.
RUN make build-pam VERSION=harness GIT_COMMIT=harness BUILD_DATE=harness \
 && mkdir -p /out \
 && cp bin/oauth2_pam.so /out/oauth2_pam.so

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssh-server openssh-client libjson-c5 libpam-modules \
      ca-certificates curl jq procps \
 && rm -rf /var/lib/apt/lists/*

# The PAM module directory differs by architecture (x86_64-linux-gnu vs
# aarch64-linux-gnu), so ask dpkg where the stock modules live rather than
# hardcoding a triplet.
COPY --from=build /out/oauth2_pam.so /tmp/oauth2_pam.so
RUN dir="$(dirname "$(dpkg -L libpam-modules | grep -m1 '/pam_permit\.so$')")" \
 && echo "installing oauth2_pam.so into $dir" \
 && install -m 0644 /tmp/oauth2_pam.so "$dir/oauth2_pam.so" \
 && rm /tmp/oauth2_pam.so

# alice is the account the mapping resolves to; bob exists so a login as bob can
# be refused for the right reason (no such user is a different failure).
#
# Both get "*" as their password hash: no password can ever match it, so the
# only way in is the module under test. ("!" would additionally mark the account
# locked, which some sshd builds reject before PAM ever runs.)
#
# pgsvc and postgres exist to cover the mapper's two account restrictions, and
# they differ from alice and bob in exactly one attribute each: pgsvc is below
# mapper.min_uid, postgres is on the system-account name denylist while being
# above the floor. Both are otherwise perfectly usable accounts with a real
# shell, so a case that refuses them cannot be passing because the login was
# impossible anyway. The UIDs must match Dockerfile.broker, which is where the
# floor is actually evaluated.
# devs is the group the mapper rule declares. It exists, and alice is *not* in
# it, which is what makes mapped_groups_not_applied evidence: if the group were
# missing, a session without it would prove nothing.
RUN useradd --create-home --shell /bin/bash --password '*' --uid 1001 alice \
 && useradd --create-home --shell /bin/bash --password '*' --uid 1002 bob \
 && useradd --create-home --shell /bin/bash --password '*' --uid 400  pgsvc \
 && useradd --create-home --shell /bin/bash --password '*' --uid 1500 postgres \
 && groupadd --gid 4200 devs \
 && mkdir -p /run/sshd

COPY test/integration/pam-sshd /etc/pam.d/sshd
COPY test/integration/sshd_config.d/oauth2-pam.conf /etc/ssh/sshd_config.d/oauth2-pam.conf
COPY test/integration/askpass.sh test/integration/cases.sh /opt/tests/
RUN chmod 0755 /opt/tests/askpass.sh /opt/tests/cases.sh

# sshd stays in the foreground as the service under test; run-tests.sh drives it
# from the host with `docker compose exec`.
CMD ["/usr/sbin/sshd", "-D", "-e"]
